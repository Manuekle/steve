# Managed by Ansible (backup role). Do not edit by hand.
[Unit]
Description=steve database backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User={{ app_user }}
Group={{ app_user }}
ExecStart=/usr/local/bin/steve-backup
# The dump is IO-bound and must never compete with a live request.
Nice=10
IOSchedulingClass=idle
