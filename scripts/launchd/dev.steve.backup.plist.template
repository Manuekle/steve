<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily local backup of this installation's Postgres.

  Not committed with real paths: launchd needs absolutes and they are specific
  to one machine and one checkout. `scripts/install-backup-agent.sh` fills
  __REPO__ and __HOME__ in and writes the result to
  ~/Library/LaunchAgents/dev.steve.backup.plist.

  Scheduling caveat, stated rather than papered over: this is a laptop.
  StartCalendarInterval fires once when the machine is awake at or after the
  hour, so a Mac asleep or shut at that time gets one backup on the next wake,
  not one per missed day. If the database matters more than that, the schedule
  belongs on a machine that stays up — deploy/roles/backup does this with a
  systemd timer.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.steve.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/scripts/backup-postgres.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>BACKUP_RETENTION</key>
    <string>__RETENTION__</string>
    <key>BACKUP_OFFSITE_DIR</key>
    <string>__OFFSITE_DIR__</string>
    <key>BACKUP_OFFSITE_COMMAND</key>
    <string>__OFFSITE_COMMAND__</string>
    <!-- launchd starts jobs with a near-empty PATH. The script finds pg_dump by
         absolute path anyway, but `docker` on the fallback path needs this. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>__HOUR__</integer>
    <key>Minute</key><integer>__MINUTE__</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/steve-backups/backup.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/steve-backups/backup.log</string>

  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
