# Steve — environment.
#
# This file is only for what has to exist before the app boots, or what the
# app cannot store for you. Everything else — model provider keys, WhatsApp,
# Instagram, ElevenLabs, Stripe, Mercado Pago, Shopify, Twilio,
# SMTP, Resend, Meta Ads, Google Sheets/Calendar, and the OAuth app client
# ids — is set from the running app, in Configuración → Settings or in
# Conexiones → Connections, and is saved to ~/.steve/credentials.json.
#
# That store is the intended place for them: keys typed there can be rotated
# and cleared from the UI, they never sit in a file next to the source, and
# they take effect without a restart. A variable set here still wins nothing
# for model keys — the store overrides it — so keeping a copy in both places
# only makes it harder to tell which one is live.

# ── Route protection ─────────────────────────────────────────────────────────
# Local loopback requests use Eve's localDev() policy; every non-loopback
# request requires these Basic credentials. Needed at boot: there is no UI to
# set the password that protects the UI.
ROUTE_AUTH_BASIC_USER="admin"
ROUTE_AUTH_BASIC_PASSWORD="replace-with-a-long-random-password"

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL container and host binding, read by docker-compose.yml. If the
# password contains URL-reserved characters, percent-encode it in
# WORKFLOW_POSTGRES_URL.
POSTGRES_USER="world"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
POSTGRES_DB="world"
POSTGRES_HOST_PORT="5544"

# Durable Workflow world. WORKFLOW_TARGET_WORLD is used by the Workflow CLI;
# Eve selects the same package in agent/agent.ts. The environment wins over
# Settings for these — a deployment that injects a connection string through
# systemd or a container runtime must not be re-pointed by a value someone
# typed into the UI months ago.
#
# Against a hosted database, use the direct connection or a *session*-mode
# pooler. The world runs on graphile-worker, which needs LISTEN/NOTIFY and
# session-scoped advisory locks; Supabase's transaction pooler (port 6543)
# has neither, and the queue fails there in ways an ordinary query does not —
# /api/health still reports `store: true` because reading a row works fine.
WORKFLOW_POSTGRES_URL="postgres://world:replace-with-a-long-random-password@127.0.0.1:5544/world"
WORKFLOW_TARGET_WORLD="@workflow/world-postgres"
# Both matter more on a serverless host than on a box, because the count is
# per instance and the instances are not yours to count. Left unset the world
# takes 50 queue workers and node-postgres takes 10 connections *each*, which
# a small hosted database will refuse long before the traffic justifies it.
WORKFLOW_POSTGRES_WORKER_CONCURRENCY="10"
WORKFLOW_POSTGRES_MAX_POOL_SIZE="12"

# The app's own four pools — documents, credits, auth, billing — hold this many
# connections each, defaulting to 5.
#
# Budget against the *pooler's* limit, not the database's. Supabase's session
# pooler allows 15 client connections out of the box no matter how high
# max_connections is, and exceeding it is a 500, not a wait:
#
#   (EMAXCONNSESSION) max clients reached in session mode -
#   max clients are limited to pool_size: 15
#
# Count every process: `pnpm dev` runs Next and the Eve host, and each holds
# its own set. Four pools at the default 5 is already 20 from one of them.
STEVE_PG_MAX_POOL_SIZE="5"

# ── Subscription billing (hosted installs only) ──────────────────────────────
# The *vendor's* Stripe account, used only to sell this installation its own
# Pro/Managed plan (/account/billing and /api/billing/webhook). It is
# deliberately not settable from the UI: the Stripe key on the Settings page
# is the operator's own merchant account, which charges their customers, and
# billing the plan on that key would have them paying themselves.
# A self-hosted Enterprise install has no plan to buy and leaves both unset,
# which turns checkout and the billing webhook off.
# STRIPE_PLATFORM_SECRET_KEY="sk_live_..."
# STRIPE_PLATFORM_WEBHOOK_SECRET="whsec_..."

# ── Build-time values ────────────────────────────────────────────────────────
# Next.js inlines these at build time, so they cannot come from the credential
# store — it is read at runtime, after the bundle already exists.

# Public origin of this installation. Used for canonical URLs, the sitemap and
# the Open Graph tags on the marketing pages, which all need absolute URLs a
# self-hosted app cannot infer.
# Falls back on Vercel to VERCEL_PROJECT_PRODUCTION_URL (the project's stable
# production domain), then to the per-deployment VERCEL_URL, then localhost.
# Leaving this unset on Vercel is fine; anywhere else, set it.
# NEXT_PUBLIC_SITE_URL="https://steve.example.com"

# Optional link shown in the web UI.
# NEXT_PUBLIC_MONITORING_URL="https://status.example.com"

# The OAuth app client ids belong in Configuración → Apps OAuth, not here (see
# the header). One thing that does not follow them there: the redirect URI is
# built from the *request's* origin, not from NEXT_PUBLIC_SITE_URL — see
# app/api/connections/[provider]/start/route.ts. So every origin this install
# answers on has to be registered with each provider separately:
#
#   https://<origin>/api/connections/google/callback
#   https://<origin>/api/connections/notion/callback
#
# A deployment whose origin was only ever registered for localhost fails at
# the provider's consent screen, after the app has already done its part.

# ── Observability (optional) ─────────────────────────────────────────────────
# The standard OTLP variables work with Jaeger, OpenObserve, and other
# OTLP/HTTP collectors. Prompt/output recording defaults to false and should be
# enabled only after reviewing the collector's retention.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"
# OTEL_EXPORTER_OTLP_HEADERS="authorization=Basic%20..."
OTEL_RECORD_INPUTS="false"
OTEL_RECORD_OUTPUTS="false"

# ── Verification only ────────────────────────────────────────────────────────
# Read by evals/isolation.eval.ts to prove the sandbox cannot see the host's
# environment. This value must never appear inside a sandbox command result.
HOST_ONLY_SECRET="host-only-verification-value"

# ── File storage (S3-compatible) ─────────────────────────────────────────────
# Where media-library files and the business logo live. Any S3-compatible
# bucket: Supabase Storage, Cloudflare R2, MinIO, AWS. All four of ENDPOINT,
# BUCKET, ACCESS_KEY_ID and SECRET_ACCESS_KEY must be set — a half-configured
# bucket is treated as no bucket, so the next upload cannot land somewhere the
# earlier ones are not.
#
# With no bucket, files go to Postgres (steve.blobs), and with no database
# either, to ~/.steve. On a host with no writable disk the bucket is the only
# one of the three that works well: a database row is an expensive place for a
# video, and Supabase's free tier gives 500 MB of database against 1 GB of
# storage.
#
# Keep the bucket PRIVATE. Reads come back through the app; nothing here mints
# a public URL. Also settable in Settings → File storage.
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Schedule cadence ─────────────────────────────────────────────────────────
# Each schedule under agent/schedules/ runs at the cron in its own file.
# STEVE_CRON_<NAME> overrides one, STEVE_CRON_DEFAULT overrides all of them.
# Read at build time: on Vercel these become cron jobs in the build output, so
# changing one takes a redeploy.
#
# The reason this exists: Vercel's Hobby plan rejects the whole deployment for
# any expression that runs more than once a day. Be clear-eyed about the cost —
# a daily reminder schedule does not deliver reminders on time. It is how you
# deploy the rest of the app on a plan that forbids the real cadence.
# STEVE_CRON_DEFAULT="0 3 * * *"

# ── Set elsewhere ────────────────────────────────────────────────────────────
# Deployment-only values are read from the operator's shell, not this file:
# DO_API_TOKEN, BESZEL_AGENT_TOKEN, JAEGER_BASIC_AUTH_USER,
# JAEGER_BASIC_AUTH_HASH.
#
# The Enterprise license goes in Settings → License. STEVE_LICENSE_KEY still
# works as a headless alternative for an unattended deploy; see
# docs/commercial-licensing.md.
