# ── Model provider ────────────────────────────────────────────────────────────
# Which service answers the agent's prompts: "gateway" (default), "openai", or
# "anthropic". Settings > Modelo de IA writes this to ~/.steve/credentials.json;
# setting it here works too. Left unset, the provider is inferred from whichever
# key exists below (OpenAI first), falling back to the Gateway.
# AI_PROVIDER="gateway"
# Optional model override. Empty uses the provider default:
# gateway openai/gpt-5-mini-fast · openai gpt-5-mini · anthropic claude-sonnet-5
# AI_MODEL=""

# Vercel AI Gateway. A string model id in agent/agent.ts routes through the
# Gateway and authenticates with this key. Also powers the Conocimiento (RAG)
# embeddings when no OpenAI key is set.
AI_GATEWAY_API_KEY=""

# Direct model providers (alternatives to the Gateway). Only the key for the
# selected AI_PROVIDER is needed. OPENAI_API_KEY doubles as the embedding key
# for the knowledge base; Anthropic ships no embedding models, so an
# Anthropic-only setup still needs the OpenAI or Gateway key for RAG.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# ── WhatsApp Business Cloud API ──────────────────────────────────────────────
# Get these from developers.facebook.com/apps > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
# Optional:
# WHATSAPP_BOT_USERNAME="whatsapp-bot"
# WHATSAPP_API_URL=""

# ── Facebook Messenger ────────────────────────────────────────────────────────
# Get these from developers.facebook.com/apps > your app > Messenger API Settings
FACEBOOK_APP_SECRET=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_VERIFY_TOKEN=""
# Optional:
# FACEBOOK_BOT_USERNAME="messenger-bot"
# FACEBOOK_API_URL=""

# ── Instagram (Instagram API with Instagram Login) ────────────────────────────
# Separate from Messenger — no Facebook Page required. The account must be a
# professional Business or Creator account. Get these from
# developers.facebook.com/apps > your app > Instagram > API Setup
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_VERIFY_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""
# Optional:
# INSTAGRAM_API_VERSION=""

# ── ElevenLabs (voice) ────────────────────────────────────────────────────────
# Powers generate_media type=audio and the "send audio" automation step. Get
# the key at elevenlabs.io/app/settings/api-keys. Unset, audio falls back to
# the AI Gateway speech model. Only the synchronous convert endpoint is used,
# so no ElevenLabs webhook is needed.
# ELEVENLABS_API_KEY=""
# Voice id from elevenlabs.io/app/voice-library. Default: George.
# ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"
# eleven_multilingual_v2 (default) · eleven_v3 · eleven_v3_conversational
# eleven_flash_v2_5 · eleven_turbo_v2_5
# ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# Production route protection. Local loopback requests use Eve's localDev()
# policy; every non-loopback request requires these Basic credentials.
ROUTE_AUTH_BASIC_USER="admin"
ROUTE_AUTH_BASIC_PASSWORD="replace-with-a-long-random-password"

# PostgreSQL container and host binding. If the password contains URL-reserved
# characters, percent-encode it in WORKFLOW_POSTGRES_URL.
POSTGRES_USER="world"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
POSTGRES_DB="world"
POSTGRES_HOST_PORT="5544"

# Durable Workflow world. WORKFLOW_TARGET_WORLD is used by the Workflow CLI;
# Eve selects the same package in agent/agent.ts.
WORKFLOW_POSTGRES_URL="postgres://world:replace-with-a-long-random-password@127.0.0.1:5544/world"
WORKFLOW_TARGET_WORLD="@workflow/world-postgres"
WORKFLOW_POSTGRES_WORKER_CONCURRENCY="10"
WORKFLOW_POSTGRES_MAX_POOL_SIZE="12"

# Used only by the isolation verification. This value must never appear inside
# a sandbox command result.
HOST_ONLY_SECRET="host-only-verification-value"

# Optional OpenTelemetry export. The standard OTLP variables work with Jaeger,
# OpenObserve, and other OTLP/HTTP collectors. Prompt/output recording defaults
# to false and should be enabled only after reviewing the collector's retention.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"
# OTEL_EXPORTER_OTLP_HEADERS="authorization=Basic%20..."
OTEL_RECORD_INPUTS="false"
OTEL_RECORD_OUTPUTS="false"

# Optional link shown in the web UI. It is embedded at Next.js build time.
# NEXT_PUBLIC_MONITORING_URL="https://status.example.com"

# Deployment-only values are read from the operator's shell, not this file:
# DO_API_TOKEN, BESZEL_AGENT_TOKEN, JAEGER_BASIC_AUTH_USER,
# JAEGER_BASIC_AUTH_HASH.

# Enterprise license token, an alternative to pasting it into Settings >
# License. Verified locally against the public key in lib/license/keys.ts —
# no network call, and never blocks the app from starting if unset, missing,
# or expired. See docs/commercial-licensing.md.
# STEVE_LICENSE_KEY=""

# Public origin of this installation. Used for canonical URLs, the sitemap and
# the Open Graph tags on the marketing pages, which all need absolute URLs a
# self-hosted app cannot infer. Embedded at Next.js build time.
# Falls back to VERCEL_URL when deployed on Vercel, then to localhost.
# NEXT_PUBLIC_SITE_URL="https://steve.example.com"
